{
  "_about": "Tokens del clon (cliente de escritorio + portal). Roles medidos del original: UI de escritorio densa, cuerpo gris claro, tarjetas blancas, un solo acento cálido de marca y una barra de sesión oscura. El acento es un PLACEHOLDER neutro: /replica-brand pone el tuyo. Los nombres no cambian, los valores sí. Comprobar con: python contrast.py replica/design/tokens.json",
  "color": {
    "bg": "#ffffff",
    "surface": "#f3f4f6",
    "surface-raised": "#ffffff",
    "surface-hover": "#e9ebef",
    "border": "#dde1e6",
    "border-input": "#7b8490",
    "text": "#16191d",
    "text-muted": "#59626e",
    "accent": "#2f5bea",
    "accent-hover": "#2449c4",
    "accent-subtle": "#e8eefd",
    "on-accent": "#ffffff",
    "focus": "#2f5bea",
    "danger": "#c62f2f",
    "danger-subtle": "#fdecec",
    "on-danger": "#ffffff",
    "success": "#1d7a4b",
    "warning": "#9a5b00",
    "warning-subtle": "#fff4e0",
    "online": "#1d7a4b",
    "offline": "#7b8490",
    "chrome-bg": "#1c1f24",
    "chrome-surface": "#2a2e35",
    "chrome-text": "#f1f3f5",
    "chrome-text-muted": "#a9b0ba",
    "chrome-border": "#8a929d",
    "canvas": "#0d0f12",
    "overlay": "rgba(22,25,29,.45)",
    "chrome-overlay": "rgba(28,31,36,.92)"
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"], ["text", "surface-hover"],
    ["text-muted", "bg"], ["text-muted", "surface"], ["text-muted", "surface-hover"],
    ["on-accent", "accent"], ["on-accent", "accent-hover"],
    ["accent", "bg"], ["accent", "accent-subtle"], ["accent", "surface"],
    ["on-danger", "danger"], ["danger", "bg"], ["danger", "danger-subtle"],
    ["success", "bg"], ["warning", "bg"], ["warning", "warning-subtle"], ["text", "warning-subtle"],
    ["chrome-text", "chrome-bg"], ["chrome-text", "chrome-surface"],
    ["chrome-text-muted", "chrome-bg"], ["chrome-text-muted", "chrome-surface"],
    ["chrome-text", "canvas"], ["chrome-text", "danger"],
    ["border-input", "bg", "ui"], ["border-input", "surface", "ui"],
    ["focus", "bg", "ui"], ["focus", "surface", "ui"],
    ["online", "bg", "ui"], ["online", "surface", "ui"], ["offline", "bg", "ui"],
    ["chrome-border", "chrome-bg", "ui"]
  ],
  "font": {
    "sans": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "type": {
    "xs":      {"size": 12, "line": 16, "weight": 500},
    "sm":      {"size": 13, "line": 18, "weight": 400},
    "base":    {"size": 14, "line": 20, "weight": 400},
    "md":      {"size": 16, "line": 24, "weight": 600},
    "lg":      {"size": 20, "line": 28, "weight": 600},
    "id":      {"size": 28, "line": 34, "weight": 600, "_note": "ID del equipo: cifras tabulares, en grupos de 3"},
    "display": {"size": 32, "line": 40, "weight": 700, "_note": "solo portal y landing"}
  },
  "space": [0, 2, 4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 64],
  "radius": {"sm": 4, "md": 6, "lg": 10, "pill": 999},
  "shadow": {
    "card": "0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.10)",
    "pop": "0 10px 28px rgba(16,24,40,.18)",
    "toolbar": "0 4px 12px rgba(0,0,0,.35)"
  },
  "motion": {"fast": "120ms", "base": "180ms", "ease": "cubic-bezier(.2,.8,.2,1)"},
  "layout": {
    "titlebar": 32, "tabstrip": 32, "addressbar": 40, "session-toolbar": 40,
    "tile-w": 176, "tile-h": 132, "side-panel": 320, "accept-panel": 360, "settings-nav": 220,
    "portal-sidebar": 240, "portal-max": 1200, "window-min-w": 720, "window-min-h": 480,
    "breakpoints": {"sm": 640, "md": 900, "lg": 1200}
  }
}
